# Puertos expuestos en tu máquina
POSTGRES_PORT=15433
N8N_PORT=5678
MCP_PORT=8082
N8N_TIMEZONE=Europe/Madrid

# Credenciales n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me

# Config de BD
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=change_me
POSTGRES_DB=indices

# El MCP debe usar la MISMA BD:
MCP_DB_NAME=indices

# Pool de conexiones
DB_POOL_MIN=1
DB_POOL_MAX=5

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=0
LOG_DIR=logs

# Scheduler
SCHEDULER_TIMEZONE=Europe/Madrid
SCHEDULER_FETCH_PERIOD=1mo
